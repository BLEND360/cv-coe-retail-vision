# Backend
VIDEO_PATH=../public/The BLEND360 Approach.mp4  # Path to video file (relative to backend dir)
VIDEO_DIR=../public                       # Directory containing video files
FRONTEND_DIR=/var/www/html                # Frontend static files (Docker only)

# Frontend (REACT_APP_ prefix required by Create React App)
REACT_APP_API_URL=http://localhost:8000   # Backend API base URL
REACT_APP_BRAND=blend360                  # Brand config: under-armour | blend360

# Docker build args (used in Dockerfile, not at runtime)
# BASE_IMAGE=python:3.11-slim            # Use nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04 for GPU
# BRAND=blend360                         # Brand selection for Docker builds
